{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "pnpm start",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "start"],
      "console": "internalConsole"
    },
    {
      "name": "Debug App",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "http://localhost:4200/**",
        "http://localhost:4210/**",
        "http://localhost:4220/**",
        "http://localhost:4230/**",
        "!**/node_modules/**"
      ],
      "sourceMapPathOverrides": {
        "../../../*": "${workspaceFolder}/*"
      }
    }
  ],
  "compounds": [
    {
      "name": "Start & Debug",
      "configurations": ["pnpm start", "Debug App"]
    }
  ]
}
