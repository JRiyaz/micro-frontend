{
  "//": "SemVer Guide: ^ (Caret) = Update Minor & Patch (e.g. 21.2.0 -> 21.3.0). ~ (Tilde) = Update Patch ONLY (e.g. 21.2.0 -> 21.2.1). No symbol = Stay on exact version.",
  "name": "inventory",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "serve": "ng serve",
    "build:lib": "ng build --project ui-shared",
    "start:shell": "ng serve --project shell",
    "start:user": "ng serve --project user-service",
    "start:store": "ng serve --project store-service",
    "start:inventory": "ng serve --project inventory-hub",
    "start:backend": "json-server --watch db.json --port 3000 --delay 5000",
    "start": "pnpm run build:lib && concurrently -k \"pnpm:start:*\"",
    "run:all": "concurrently -k \"pnpm:start:*\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prepare": "husky install",
    "postinstall": "sh submodule-husky-hook-path.sh"
  },
  "private": true,
  "dependencies": {
    "@angular-architects/native-federation": "^21.2.3",
    "@angular/animations": "^21.2.10",
    "@angular/common": "^21.2.10",
    "@angular/compiler": "^21.2.10",
    "@angular/core": "^21.2.10",
    "@angular/forms": "^21.2.10",
    "@angular/platform-browser": "^21.2.10",
    "@angular/platform-browser-dynamic": "^21.2.10",
    "@angular/router": "^21.2.10",
    "@softarc/native-federation-node": "^3.3.4",
    "es-module-shims": "^1.5.12",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.8",
    "@angular/build": "^21.2.8",
    "@angular/cli": "^21.2.8",
    "@angular/compiler-cli": "^21.2.10",
    "@biomejs/biome": "^2.4.15",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.1.0",
    "husky": "^8.0.0",
    "jasmine-core": "~5.2.0",
    "json-server": "0.17.4",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^21.2.3",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.9.3"
  }
}
