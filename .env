# nginx, apache
COMPOSE_PROFILES=nginx

export CERT_PATH="E:/micro-service/micro-frontend/certs"
export LOG_LEVEL=warn

export WORKING_PATH="./projects/shell/public"
# TODO: Dynamic port changes for USER service won't work unless `E:\micro-service\micro-frontend\projects\shell\public\federation.manifest.json` is handled.
export SHELL_HOST="http://host.docker.internal"
export SHELL_PORT=4200

export USER_PORT=11115
export USER_HOST="http://localhost"
